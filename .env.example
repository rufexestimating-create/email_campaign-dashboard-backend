# Resend API Key (from https://resend.com/api-keys)
RESEND_API_KEY=re_your_api_key_here

# From address: If verified on Resend via Hostinger DNS, use: hello@yourdomain.com
# For testing without verified domain, use: onboarding@resend.dev (only sends to your registered Resend email)
DEFAULT_FROM_EMAIL=onboarding@resend.dev

# Resend -> Webhooks -> your endpoint -> Signing secret. Without it, webhook events are refused.
RESEND_WEBHOOK_SECRET=whsec_your_signing_secret

# Supabase -> Project Settings -> API. Use the service_role key (backend only, never expose to the browser)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT signing secret. Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Where verification / password-reset links should point (on Render: your Netlify site address)
FRONTEND_URL=http://localhost:3000

# Company name and accent colour used in emails
BRAND_NAME=Arvistry
BRAND_COLOR=#C2410C

# Emails your Resend plan allows per day (free plan: 100)
DAILY_SEND_LIMIT=100

# Spam detector (moving to its own app). false = campaign system only: no spam scoring or spam guide here.
SPAM_DETECTOR_ENABLED=false
